# SwitchBot BLE Configuration
# MAC address of your SwitchBot Bot (e.g. AA:BB:CC:DD:EE:FF)
SWITCHBOT_MAC=AA:BB:CC:DD:EE:FF

# Password / PIN if set in the SwitchBot app (leave empty if none)
SWITCHBOT_PASSWORD=

# Telegram Bot (Optional: get token from @BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated allowed Telegram user IDs (optional security restriction)
TELEGRAM_ALLOWED_USERS=

# Web Dashboard & REST API
WEB_HOST=0.0.0.0
WEB_PORT=8085
WEB_API_KEY=
